//"Classe Main"
public class Main {
    public static void main(String[] args) {

        Livro meuLivro = new Livro("Por Lugares Incríveis", "Jennifer Niven", 355);

        meuLivro.exibirInformacoes();
    }
}

//"Classe Livro"
public class Livro {

    String titulo;
    String autor;
    int paginas;


    public Livro(String titulo, String autor, int paginas) {
        this.titulo = titulo;
        this.autor = autor;
        this.paginas = paginas;
    }


    public void exibirInformacoes() {
        System.out.println("Titulo: " + titulo+"\nAutor: " + autor+"\nPaginas: " + paginas);
    }
}
